#include "rv1106.dtsi"
#include <dt-bindings/input/input.h>

/ {
	model = "Luckfox Core1106 Module";
	compatible = "luckfox,core1106","rockchip,rv1106";

	chosen {
		stdout-path = "serial2:115200n8";
	};

	vcc_1v8: vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	vcc_3v3: vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	vdd_arm: vdd-arm {
		compatible = "regulator-fixed";
		regulator-name = "vdd_arm";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_LOW>;
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1000000>;
		poll-interval = <100>;

		button-recovery {
			label = "Recovery";
			linux,code = <KEY_SETUP>;
			press-threshold-microvolt = <500000>;
		};
	};
};

// FIXME: 1200 and 1296 MHz should work with 0.9V. Is this a carrier board issue?
&cpu0_opp_table {
		/delete-node/ opp-1200000000;
		/delete-node/ opp-1296000000;
		/delete-node/ opp-1416000000;
		/delete-node/ opp-1512000000;
		/delete-node/ opp-1608000000;
};

&usbdrd_dwc3 {
	extcon = <&u2phy>;
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

&saradc {
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

&i2c1 {
	pinctrl-0 = <&i2c1m1_xfer>;
};
&i2c2 {
	pinctrl-0 = <&i2c2m0_xfer>;
};

&uart0 {
	pinctrl-0 = <&uart0m0_xfer &uart0m1_xfer>;
};
&uart1 {
	pinctrl-0 = <&uart1m1_xfer>;
};
&uart2 {
	pinctrl-0 = <&uart2m1_xfer>;
	status = "okay";
};
&uart3 {
	pinctrl-0 = <&uart3m0_xfer &uart3m1_xfer>;
};
&uart4 {
	pinctrl-0 = <&uart4m0_xfer &uart4m1_xfer>;
};
&uart5 {
	pinctrl-0 = <&uart5m1_xfer>;
};

&pinctrl {
	spi0 {
		spi0m0_clk: spi0m0-clk {
			rockchip,pins = <1 RK_PC1 4 &pcfg_pull_none>;
		};
		spi0m0_mosi: spi0m0-mosi {
			rockchip,pins = <1 RK_PC2 6 &pcfg_pull_none>;
		};
		spi0m0_miso: spi0m0-miso {
			rockchip,pins = <1 RK_PC3 6 &pcfg_pull_none>;
		};
		spi0m0_cs0: spi0m0-cs0 {
			rockchip,pins = <1 RK_PC0 4 &pcfg_pull_none>;
		};
	};
};
&spi0 {
	pinctrl-0 = <&spi0m0_clk &spi0m0_miso &spi0m0_mosi &spi0m0_cs0>;
};

&emmc {
	cap-mmc-highspeed;
	mmc-ddr-3_3v;
	bus-width = <8>;
	non-removable;
	rockchip,default-sample-phase = <90>;
	no-sdio;
	no-sd;
	disable-wp;
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&emmc_bus8 &emmc_cmd &emmc_clk>;

	vqmmc-supply = <&vcc_3v3>;
	vmmc-supply = <&vcc_3v3>;
	no-1-8-v;
};

&pinctrl {
	sdmmc0 {
		/omit-if-no-ref/
		sdmmc0_det: sdmmc0-det {
			rockchip,pins =
				/* sdmmc0_det */
				<3 RK_PA1 1 &pcfg_pull_down>;
		};
	};
};

&sdmmc {
	max-frequency = <50000000>;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	non-removable;
	rockchip,default-sample-phase = <90>;
	no-sd;
	no-mmc;
	disable-wp;
	mmc-pwrseq = <&sdio_pwrseq>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_bus4 &sdmmc0_det>;
	status = "okay";

	vqmmc-supply = <&vcc_3v3>;
	vmmc-supply = <&vcc_3v3>;
	no-1-8-v;
};
